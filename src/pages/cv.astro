---
import Base from '../layouts/Base.astro';

const cvHref = '/cv/maarij-cv.pdf';
---

<Base title="CV — Maarij Alam">
  <div class="cv__header">
    <h1>CV</h1>
    <a class="cv__download mono" href={cvHref} download>Download PDF</a>
  </div>

  <object
    class="cv__pdf"
    data={cvHref}
    type="application/pdf"
    aria-label="Maarij Alam CV — PDF preview"
  >
    <p class="cv__fallback">
      Your browser can't preview PDFs inline.
      <a href={cvHref} download>Download the CV (PDF)</a>.
    </p>
  </object>
</Base>

<style>
  .cv__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .cv__download {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 0.5px solid var(--signal);
    border-radius: 2px;
    color: var(--signal);
    text-decoration: none;
    transition: background 120ms linear, color 120ms linear;
  }
  .cv__download:hover {
    background: var(--signal);
    color: var(--paper);
  }
  .cv__pdf {
    display: block;
    width: 100%;
    height: 80vh;
    min-height: 40rem;
    border: 0.5px solid var(--rule);
    border-radius: 2px;
  }
  .cv__fallback {
    padding: var(--space-6);
    text-align: center;
    margin: 0;
  }
</style>
