---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import hero from '../assets/placeholders/hero-16x9.svg';

const all = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((p) => p.data.featured);
const cards = (featured.length > 0 ? featured : all).slice(0, 3);
---

<Base title="Maarij Alam — Electrical & Computer Engineering">
  <p class="mono home__eyebrow">BSCENG ELECTRICAL &amp; COMPUTER ENGINEERING · UCT · 2026</p>

  <h1 class="home__headline">TODO: main positioning headline</h1>

  <p class="home__intro">TODO: intro paragraph (1–3 sentences, sits at ~52ch)</p>

  <div class="home__hero">
    <Image src={hero} alt="TODO: alt text for the intended homepage hero image" widths={[800, 1200, 1600, 2000]} sizes="100vw" loading="eager" />
  </div>

  <section class="selected-work" aria-labelledby="selected-work-heading">
    <header class="selected-work__header">
      <h2 id="selected-work-heading" class="mono selected-work__title">Selected work</h2>
      <a class="mono selected-work__all" href="/projects/">All projects →</a>
    </header>

    <div class="grid">
      {cards.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<style>
  .home__eyebrow { margin: 0 0 var(--space-4); }

  .home__headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 3.75rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 15ch;
    margin: 0 0 var(--space-5);
  }

  .home__intro {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 52ch;
    color: var(--muted);
    margin: 0 0 var(--space-7);
  }

  .home__hero {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }
  .home__hero :global(img),
  .home__hero :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  .selected-work { margin-top: var(--space-8); }
  .selected-work__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-6);
    border-bottom: 0.5px solid var(--rule);
  }
  .selected-work__title { margin: 0; }
  .selected-work__all {
    text-decoration: none;
    color: var(--signal);
  }
  .selected-work__all:hover { color: var(--ink); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  @media (max-width: 899px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .grid { grid-template-columns: 1fr; }
    .home__headline { font-size: 2.75rem; }
  }
</style>
