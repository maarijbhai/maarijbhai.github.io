---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import portrait from '../assets/portrait.jpg';

const all = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.filter((p) => p.data.featured);
const cards = (featured.length > 0 ? featured : all).slice(0, 3);

// Five-cycle ECG trace across a 1200 × 200 viewBox.
// Baseline y=100. Reduced amplitude — R peak reaches y=60 instead of y=20.
const CYCLE_WIDTH = 240;
const CYCLES = 5;

function cyclePath(x: number): string {
  return [
    `L ${x + 24} 100`,                  // pre-P baseline
    `Q ${x + 36} 80 ${x + 48} 100`,     // P wave (peak y=90)
    `L ${x + 72} 100`,                  // PR segment
    `L ${x + 78} 104`,                  // Q dip
    `L ${x + 84} 60`,                   // R peak (halved from y=20)
    `L ${x + 90} 120`,                  // S dip (halved)
    `L ${x + 96} 100`,                  // S recovery
    `L ${x + 120} 100`,                 // ST segment
    `Q ${x + 150} 70 ${x + 180} 100`,   // T wave (peak y=85)
    `L ${x + 240} 100`,                 // post-T baseline
  ].join(' ');
}

const ecgPath =
  `M 0 100 ` +
  Array.from({ length: CYCLES }, (_, i) => cyclePath(i * CYCLE_WIDTH)).join(' ');
---

<Base title="Maarij Alam — Electrical & Computer Engineering" navVariant="dark">
  <section class="home-hero" aria-labelledby="home-hero-heading">
    <svg
      class="home-hero__bg"
      viewBox="0 0 1200 200"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        class="home-hero__trace"
        d={ecgPath}
        fill="none"
        stroke="var(--trace)"
        stroke-width="1.5"
        stroke-linejoin="round"
        stroke-linecap="round"
        pathLength="1000"
      />
    </svg>

    <div class="home-hero__inner">
      <p class="home-hero__eyebrow mono">BSCENG ELECTRICAL &amp; COMPUTER ENGINEERING · UCT · 2026</p>
      <h1 id="home-hero-heading" class="home-hero__title">
        I'm <span class="home-hero__accent">Maarij</span>. A final year Electrical and Computer Engineering Student at UCT
      </h1>
      <p class="home-hero__sub">A Problem Solver at Heart</p>
      <a class="home-hero__cta mono" href="#work">VIEW MY WORK</a>
    </div>
  </section>

  <section class="about-strip" aria-labelledby="about-strip-heading">
    <div class="about-strip__portrait">
      <Image
        src={portrait}
        alt="Maarij Alam, portrait beneath a concrete walkway with stone columns"
        widths={[540, 720, 1080, 1440]}
        sizes="(max-width: 767px) 100vw, 360px"
        quality={90}
      />
    </div>
    <div class="about-strip__text">
      <h2 id="about-strip-heading" class="about-strip__heading">Meet Me</h2>
      <p>I'm a final-year electrical and computer engineering student at UCT, finishing in November 2026. My friends call me MJ so if that's what you're more comfortable with go for it.
        I would best describe myself as a problem solver at heart. As an ECE student, I love tackling problems in both hardware and software (and the space in between). I love meeting new people and I thrive when collaborating with others. Go ahead and peruse my profile for more about me!
        
         </p>
      <!--Most of what I build sits close to the hardware — firmware, signal processing, boards that have to work outside a lab — and increasingly the software layer on top of it. </p>
      <p>Right now I'm digitising ECGs on consumer phones for my thesis. Before that I was writing firmware for Antarctic sensors and building state estimation for drones. -->
      <a class="about-strip__more mono" href="/about/">MORE ABOUT ME →</a>
    </div>
  </section>

  <section id="work" class="selected-work" aria-labelledby="selected-work-heading">
    <header class="selected-work__header">
      <h2 id="selected-work-heading" class="mono selected-work__title">Selected work</h2>
      <a class="mono selected-work__all" href="/projects/">All projects →</a>
    </header>

    <div class="grid">
      {cards.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<style>
  /* ---------- Dark hero ---------- */

  .home-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: calc(-1 * var(--space-7));
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink-dark);
    color: var(--paper);
    padding: var(--space-8) var(--page-pad);
    overflow: hidden;
  }

  .home-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .home-hero__trace {
    opacity: 0.3;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: home-hero-sweep 6s ease-in-out infinite;
  }

  @keyframes home-hero-sweep {
    0%   { stroke-dashoffset: 1000; }  /* empty */
    42%  { stroke-dashoffset: 0; }     /* fully drawn left→right */
    58%  { stroke-dashoffset: 0; }     /* hold */
    100% { stroke-dashoffset: -1000; } /* erased left→right, loops seamlessly to empty */
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    text-align: center;
  }

  .home-hero__eyebrow {
    color: var(--muted-dark);
    margin: 0 0 var(--space-4);
  }

  .home-hero__title {
    font-family: 'Archivo', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper);
    margin: 0 0 var(--space-4);
  }

  .home-hero__accent { color: var(--trace); }

  .home-hero__sub {
    font-family: 'Source Serif 4', 'Source Serif Pro', Georgia, serif;
    color: var(--muted-dark);
    max-width: 46ch;
    margin: 0 auto var(--space-6);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .home-hero__cta {
    display: inline-block;
    color: var(--paper);
    text-decoration: none;
    padding: 0 0 4px;
    border-bottom: 1px solid var(--trace);
    transition: color 120ms linear;
  }
  .home-hero__cta:hover { color: var(--trace); }
  .home-hero__cta:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__trace {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  /* ---------- About strip ---------- */

  .about-strip {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 40px;
    align-items: center;
    padding: 6rem 0;
  }

  .about-strip__portrait {
    width: 360px;
    max-width: 100%;
  }
  .about-strip__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 35%;
    border-radius: 0;
  }

  .about-strip__text { min-width: 0; }
  .about-strip__heading {
    font-family: 'Archivo', var(--font-display);
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }
  .about-strip__text p {
    font-family: 'Source Serif 4', 'Source Serif Pro', Georgia, serif;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--ink);
    max-width: 60ch;
    margin: 0 0 var(--space-4);
  }
  .about-strip__more {
    display: inline-block;
    color: var(--signal);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--signal);
    margin-top: var(--space-3);
    transition: color 120ms linear, border-color 120ms linear;
  }
  .about-strip__more:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (max-width: 767px) {
    .about-strip {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding: 5rem 0;
    }
    .about-strip__portrait { width: 100%; max-width: 360px; }
  }

  /* ---------- Selected work ---------- */

  .selected-work { margin-top: var(--space-8); scroll-margin-top: var(--space-6); }
  .selected-work__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-6);
    border-bottom: 0.5px solid var(--rule);
  }
  .selected-work__title { margin: 0; }
  .selected-work__all {
    text-decoration: none;
    color: var(--signal);
  }
  .selected-work__all:hover { color: var(--ink); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  @media (max-width: 899px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
