---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, keyResult, domain, hero, heroAlt } = project.data;
---

<a
  class="card"
  href={`/projects/${project.id}/`}
  data-domain={domain}
>
  <div class="card__media">
    <Image src={hero} alt={heroAlt} widths={[400, 800, 1200]} sizes="(max-width: 599px) 100vw, (max-width: 899px) 50vw, 33vw" />
  </div>
  <div class="card__body">
    <p class="card__tag mono">{domain}</p>
    <h3 class="card__title">{title}</h3>
    <p class="card__result">{keyResult}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    color: var(--ink);
    text-decoration: none;
    transition: color 120ms linear;
  }
  .card__media { overflow: hidden; }
  .card :global(img),
  .card :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
    transition: opacity 120ms linear;
  }
  .card:hover :global(img),
  .card:hover :global(svg) { opacity: 0.9; }

  .card__body { padding: var(--space-3) 0 0; }
  .card__tag { margin: 0 0 var(--space-2); }
  .card__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
    color: var(--ink);
  }
  .card:hover .card__title { color: var(--signal); }
  .card__result {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--trace);
    margin: 0;
  }
</style>
