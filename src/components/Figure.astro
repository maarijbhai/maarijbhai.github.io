---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <Image src={src} alt={alt} />
  {caption && <figcaption class="figure__caption mono">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0 0 var(--space-6);
  }
  .figure :global(img),
  .figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  .figure__caption {
    margin-top: var(--space-2);
  }
</style>
