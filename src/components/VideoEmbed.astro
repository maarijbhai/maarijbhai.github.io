---
interface Props {
  youtubeId?: string;
  videoLoop?: string;
  videoAlt?: string;
  title?: string;
}
const {
  youtubeId,
  videoLoop,
  videoAlt = 'Silent looping clip of the project in operation.',
  title = 'Project video',
} = Astro.props;
---

{videoLoop ? (
  <figure class="video-embed video-embed--loop">
    <video
      src={videoLoop}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={videoAlt}
    ></video>
    <figcaption class="video-embed__caption mono">{videoAlt}</figcaption>
  </figure>
) : youtubeId ? (
  <div class="video-embed">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title={title}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
) : (
  <div class="video-embed video-embed--placeholder">
    <span class="mono">VIDEO — TO BE ADDED</span>
  </div>
)}

<style>
  .video-embed {
    margin: var(--space-6) 0;
  }
  .video-embed:not(.video-embed--placeholder):not(.video-embed--loop) {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-embed--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-6);
    border: 0.5px solid var(--rule);
    border-radius: 2px;
    min-height: 8rem;
    text-align: center;
  }

  .video-embed--loop { margin: var(--space-6) 0; }
  .video-embed--loop video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    background: var(--rule);
  }
  .video-embed__caption {
    margin-top: var(--space-2);
    color: var(--muted);
  }
</style>
