---
interface Props {
  youtubeId?: string;
  title?: string;
}
const { youtubeId, title = 'Project video' } = Astro.props;
---

{youtubeId ? (
  <div class="video-embed">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title={title}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
) : (
  <div class="video-embed video-embed--placeholder">
    <span class="mono">VIDEO — TO BE ADDED</span>
  </div>
)}

<style>
  .video-embed {
    margin: var(--space-6) 0;
  }
  .video-embed:not(.video-embed--placeholder) {
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-embed--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-6);
    border: 0.5px solid var(--rule);
    border-radius: 2px;
    min-height: 8rem;
    text-align: center;
  }
</style>
